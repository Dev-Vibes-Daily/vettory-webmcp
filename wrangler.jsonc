{
  "name": "vettory-webmcp",
  "main": "worker.js",
  "compatibility_date": "2024-11-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // Free, built-in per-key rate limiting (limits are per Cloudflare location).
  // DEMO_LIMITER: throttles the public demo key + the public catalog feed by IP.
  // KEY_LIMITER: the higher allowance for keys Vettory issues to signups.
  "ratelimits": [
    { "name": "DEMO_LIMITER", "namespace_id": "2001", "simple": { "limit": 30, "period": 60 } },
    { "name": "KEY_LIMITER", "namespace_id": "2002", "simple": { "limit": 600, "period": 60 } }
  ]
}
